---
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="竹节 AI 工具导航站，涵盖聊天、图像、写作、视频等类别，发现最好用的 AI 产品。">
    <title>{title}</title>
    <style>
      body { margin: 0; font-family: sans-serif; }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>